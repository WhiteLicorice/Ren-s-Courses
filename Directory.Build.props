<Project>
  <PropertyGroup>
    <DefaultItemExcludes>$(DefaultItemExcludes);**/bin/**/*;**/obj/**/*;artifacts/**/*;node_modules/**/*;output/**/*;tests/**/*;wwwroot/pdfs/**/*;Dependencies/**/*</DefaultItemExcludes>
    <DefaultExcludesInProjectFolder>$(DefaultExcludesInProjectFolder);**/bin/**/*;**/obj/**/*;artifacts/**/*;node_modules/**/*;output/**/*;tests/**/*;wwwroot/pdfs/**/*;Dependencies/**/*</DefaultExcludesInProjectFolder>
  </PropertyGroup>
</Project>
