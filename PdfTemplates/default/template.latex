% Unified Pandoc LaTeX template for UP Visayas DPSM course materials.
% Formal syllabus metadata selects compact OBE typography; wide tables use
% the shared ruled landscape renderer in every document type.

\documentclass[a4paper,$if(pdf.variables.academicTerm)$10pt$else$11pt$endif$]{article}

% --- Core packages ---
\usepackage[utf8]{inputenc}
\usepackage[T1]{fontenc}
\usepackage{upquote}
\usepackage{microtype}
\usepackage[
$if(pdf.variables.academicTerm)$
  left=0.58in,
  right=0.58in,
  top=0.58in,
  bottom=0.62in,
$else$
  left=0.68in,
  right=0.68in,
  top=0.70in,
  bottom=0.68in,
$endif$
  headheight=15pt,
  headsep=0.18in,
  footskip=0.38in
]{geometry}
\usepackage{graphicx}
\usepackage[export]{adjustbox}
\usepackage[table]{xcolor}
\usepackage{setspace}
\usepackage{ragged2e}
\usepackage{hyperref}
\usepackage{bookmark}
\usepackage{fancyhdr}
\usepackage{eso-pic}
\usepackage{longtable,booktabs,array}
\usepackage{calc}
\newcounter{none}
\usepackage[normalem]{ulem}
\usepackage{float}
\floatplacement{figure}{H}
\usepackage{caption}
\usepackage{ifxetex}
\usepackage{ifluatex}
\usepackage{amsmath,amssymb}
\usepackage{enumitem}
\usepackage{titlesec}
\usepackage{pdflscape}
$if(math)$
  $math$
$endif$

% --- Institutional palette ---
\definecolor{upmaroon}{HTML}{8F1537}
\definecolor{upgreen}{HTML}{007A5E}
\definecolor{upgray}{HTML}{6F6F6F}
\definecolor{tablegray}{HTML}{EEEEEE}
\definecolor{shadecolor}{RGB}{248,248,248}

% --- Fonts: bundle-owned TeX Gyre Heros keeps builds host-independent ---
\usepackage{tgheros}
\usepackage{tgtermes}
\renewcommand{\familydefault}{\sfdefault}
\usepackage{courier}
\ifxetex
  \usepackage{fontspec}
  \setsansfont{texgyreheros-regular.otf}[
    BoldFont=texgyreheros-bold.otf,
    ItalicFont=texgyreheros-italic.otf,
    BoldItalicFont=texgyreheros-bolditalic.otf]
  \setmainfont{texgyreheros-regular.otf}[
    BoldFont=texgyreheros-bold.otf,
    ItalicFont=texgyreheros-italic.otf,
    BoldItalicFont=texgyreheros-bolditalic.otf]
  \setmonofont{lmmono10-regular.otf}
\fi

% --- Reusable metadata ---
\newcommand{\DocumentType}{$if(pdf.variables.documentType)$$pdf.variables.documentType$$else$Course Material$endif$}
\newcommand{\CourseCode}{$if(pdf.variables.courseCode)$$pdf.variables.courseCode$$else$$firstTag$$endif$}
\newcommand{\MaterialSubtitle}{$if(subtitle)$$subtitle$$endif$}
\newcommand{\PreparedBy}{$if(author)$Prepared by: $for(author)$$author$$sep$, $endfor$$endif$}
\newcommand{\RunningHeaderText}{%
  \ifodd\value{page}\PreparedBy\else\MaterialSubtitle\fi}
\newcommand{\LandscapeContentHeader}{%
  \noindent\makebox[\linewidth]{%
    \scriptsize\color{upgray}\thepage\ \textbar{} Page%
    \hfill\RunningHeaderText}\par
  \vspace{0.3ex}{\color{black!50}\hrule height 0.25pt}\vspace{1.0ex}}
\newcommand{\TemplateAssets}{\detokenize{$templateAssets$}}
\newcommand{\CourseTitleFont}{\fontfamily{qtm}\fontseries{b}\selectfont}
\newif\ifsyllabuslandscape
\syllabuslandscapefalse
\newcommand{\SyllabusLandscapeBegin}{%
  \clearpage
  \syllabuslandscapetrue
  \begin{landscape}%
  \pagestyle{empty}%
}
\newcommand{\SyllabusLandscapeEnd}{%
  \end{landscape}%
  \syllabuslandscapefalse
  \clearpage
  \pagestyle{fancy}%
}

% --- Running page furniture from the OBE form ---
\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\scriptsize\color{upgray}\thepage\ \textbar{} Page}
\fancyhead[R]{\scriptsize\color{upgray}\RunningHeaderText}
\fancyfoot[C]{}
\renewcommand{\headrulewidth}{0.25pt}
\renewcommand{\footrulewidth}{0pt}

\fancypagestyle{firstpage}{
  \fancyhf{}
  \renewcommand{\headrulewidth}{0pt}
}

\AddToShipoutPictureBG{%
  \ifsyllabuslandscape\else
    \AtPageLowerLeft{\color{upmaroon}\rule{\paperwidth}{0.26in}}%
    \AtPageLowerLeft{\raisebox{0.26in}{\color{upgreen}\rule{\paperwidth}{0.055in}}}%
  \fi
}

% --- Links and PDF metadata ---
\hypersetup{
  colorlinks=true,
  linkcolor=black,
  urlcolor=blue,
  citecolor=black,
  bookmarks=true,
$if(title)$
  pdftitle={$title$},
$endif$
$if(author)$
  pdfauthor={$for(author)$$author$$sep$, $endfor$},
$endif$
}
\urlstyle{same}

% --- Code blocks ---
\usepackage{fancyvrb}
\usepackage{fvextra}
\DefineVerbatimEnvironment{Highlighting}{Verbatim}{}
$if(highlighting-macros)$
$highlighting-macros$
$endif$
\RecustomVerbatimEnvironment{Highlighting}{Verbatim}{
  commandchars=\\\{\},
  frame=single,
  framerule=0.4pt,
  framesep=6pt,
  rulecolor=\color{black!25},
  numbers=left,
  numbersep=8pt,
  breaklines=true,
  breakautoindent=false,
  breakindent=1em,
  fontsize=\small
}
\usepackage{framed}

% --- Body typography ---
\setlength{\parindent}{0pt}
$if(pdf.variables.academicTerm)$
\setlength{\parskip}{0.42em}
$else$
\setlength{\parskip}{0.48em}
$endif$
\setlength{\emergencystretch}{2em}
\setlist{nosep,leftmargin=1.65em}
\setlist[description]{
  style=multiline,
$if(pdf.variables.academicTerm)$
  leftmargin=1.92in,
  labelwidth=1.60in,
  labelsep=0.22in,
  font=\normalfont\bfseries,
  itemsep=0.44em,
  parsep=0.22em
$else$
  leftmargin=2.05in,
  labelwidth=1.82in,
  font=\normalfont\bfseries,
  itemsep=0.55em
$endif$
}

$if(pdf.variables.academicTerm)$
\titleformat{\section}
  {\normalsize\bfseries}
  {}{0pt}{}
$else$
\titleformat{\section}
  {\normalsize\bfseries}
  {}{0pt}{}
  [\vspace{0.08em}\titlerule]
$endif$
\titleformat{\subsection}
  {\small\bfseries}
  {}{0pt}{}
\titleformat{\subsubsection}
  {\small\itshape\bfseries}
  {}{0pt}{}
\titleformat{\paragraph}[hang]
  {\small\bfseries}
  {\theparagraph}{1em}{}
\titleformat{\subparagraph}[hang]
  {\small\itshape}
  {\thesubparagraph}{1em}{}
$if(pdf.variables.academicTerm)$
\titlespacing*{\section}{0pt}{1.05em}{0.40em}
\titlespacing*{\subsection}{0pt}{0.75em}{0.24em}
$else$
\titlespacing*{\section}{0pt}{1.25em}{0.55em}
\titlespacing*{\subsection}{0pt}{0.9em}{0.32em}
$endif$
\titlespacing*{\subsubsection}{0pt}{0.7em}{0.25em}

% --- Tables ---
\renewcommand{\arraystretch}{1.12}
\setlength{\tabcolsep}{4pt}
\arrayrulecolor{black!35}

% --- Image sizing ---
\makeatletter
\newsavebox\pandoc@box
\newcommand*\pandocbounded[1]{%
  \sbox\pandoc@box{#1}%
  \Gscale@div\@tempa{\textheight}{\dimexpr\ht\pandoc@box+\dp\pandoc@box\relax}%
  \Gscale@div\@tempb{\linewidth}{\wd\pandoc@box}%
  \ifdim\@tempb\p@<\@tempa\p@\let\@tempa\@tempb\fi
  \ifdim\@tempa\p@<\p@\scalebox{\@tempa}{\usebox\pandoc@box}%
  \else\usebox{\pandoc@box}%
  \fi}
\makeatother

\providecommand{\tightlist}{%
  \setlength{\itemsep}{0pt}\setlength{\parskip}{0pt}}

\begin{document}
\thispagestyle{firstpage}

