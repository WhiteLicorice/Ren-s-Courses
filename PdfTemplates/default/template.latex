$endif$
$if(publishedFormatted)$
  \vspace{0.08in}
  {\small\textbf{Published:} $publishedFormatted$
  $if(deadlineFormatted)$\hspace{0.35in}\textbf{Deadline:} $deadlineFormatted$$endif$}\par
$endif$
