@inject IWebHostEnvironment HostEnvironment
@using BlazorStaticMinimalBlog.Models

<!DOCTYPE html>
<html lang="en" data-environment="@HostEnvironment.EnvironmentName" class="scroll-smooth">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />

    <link rel="apple-touch-icon" sizes="180x180" href="apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="favicon-16x16.png">
    <link rel="manifest" href="site.webmanifest">
    <link rel="icon" type="image/x-icon" href="favicon.ico">

    @* --- STYLES --- *@
    <link href="@(WebsiteKeys.VersionedAsset("css/app.css"))" rel="stylesheet" />
    <link href="@(WebsiteKeys.VersionedAsset("css/site.css"))" rel="stylesheet" />

    @* --- PRISM THEMES --- *@
    <link rel="preload" href="@(WebsiteKeys.VersionedAsset("css/prism-dark.css"))" as="style">
    <link rel="preload" href="@(WebsiteKeys.VersionedAsset("css/prism-light.css"))" as="style">
    <link id="prism-theme-link" rel="stylesheet"
        href="@(WebsiteKeys.VersionedAsset("css/prism-dark.css"))"
        data-dark-href="@(WebsiteKeys.VersionedAsset("css/prism-dark.css"))"
        data-light-href="@(WebsiteKeys.VersionedAsset("css/prism-light.css"))">

    @* --- BOOT SCRIPT --- *@
    @{
        var registryEntries = string.Join(",", SiteThemeRegistry.All.Select(t => $"{{site:'{t.Name}',mermaid:'{t.MermaidTheme}'}}"));
        var registryColors = string.Join(",", SiteThemeRegistry.All.Select(t => $"'{t.Name}':'{t.ThemeColor}'"));
    }
    <script>
        window.siteThemeRegistry = [@((MarkupString)registryEntries)];
        window.siteThemeColors = {@((MarkupString)registryColors)};
        (function () {
            var registry = window.siteThemeRegistry.map(function (e) { return e.site; });
            var systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            var savedTheme = localStorage.getItem('user-theme');
            var mode = registry.indexOf(savedTheme) >= 0 ? savedTheme
                : systemDark
                    ? (registry.indexOf('dark') >= 0 ? 'dark' : registry[0])
                    : (registry.indexOf('light') >= 0 ? 'light' : registry[0]);

            document.documentElement.setAttribute('data-theme', mode);
            var prismTheme = document.getElementById('prism-theme-link');
            if (prismTheme && mode === 'light' && prismTheme.dataset.lightHref) {
                prismTheme.href = prismTheme.dataset.lightHref;
            }

            var meta = document.querySelector('meta[name="theme-color"]');
            if (!meta) {
                meta = document.createElement('meta');
                meta.name = 'theme-color';
                document.head.appendChild(meta);
            }
            meta.content = window.siteThemeColors[mode] || (mode === 'light' ? '#f8f9fa' : '#111827');
        })();
    </script>

    @* Pinned local Prism runtime and language set. *@
    <script src="@(WebsiteKeys.VersionedAsset("vendor/prism/prism.js"))" data-manual></script>
    @foreach (var language in new[] { "python", "nasm", "bash", "powershell", "kotlin", "c", "gdscript", "csharp", "markdown", "fortran", "lisp", "cobol", "smalltalk", "cpp", "java", "rust", "toml", "yaml", "dart", "go", "julia", "json", "cmake" })
    {
        <script src="@(WebsiteKeys.VersionedAsset($"vendor/prism/prism-{language}.min.js"))"></script>
    }
    <HeadOutlet />
</head>

<body class="min-h-screen bg-bg-base font-sans text-text-dim antialiased selection:bg-accent selection:text-white">
    <Routes />

    @* --- CUSTOM SCRIPTS --- *@
    <script src="@(WebsiteKeys.VersionedAsset("js/theme.js"))"></script>
    <script src="@(WebsiteKeys.VersionedAsset("js/calendar.js"))"></script>
    <script src="@(WebsiteKeys.VersionedAsset("js/code-features.js"))"></script>
    <script src="@(WebsiteKeys.VersionedAsset("js/scrollbars.js"))"></script>
    <script src="@(WebsiteKeys.VersionedAsset("js/scroll-button.js"))"></script>
    <script src="@(WebsiteKeys.VersionedAsset("js/submission-menu.js"))"></script>
    <script src="@(WebsiteKeys.VersionedAsset("js/toc.js"))"></script>
    <script src="@(WebsiteKeys.VersionedAsset("js/course-filter.js"))"></script>
    <script src="@(WebsiteKeys.VersionedAsset("js/faq.js"))"></script>

    @* IMPORTANT: This must come last, as it is the orchestrator. *@
    <script src="@(WebsiteKeys.VersionedAsset("js/site.js"))"></script>

</body>

</html>
