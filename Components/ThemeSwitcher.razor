@using BlazorStaticMinimalBlog.Models

<div class="flex gap-2" data-theme-switcher>
    @foreach (var theme in SiteThemeRegistry.All)
    {
        <button type="button" data-theme-switch="@theme.Name"
                class="px-3 py-1 rounded text-xs font-mono border transition-all border-border-muted text-text-dim hover:text-text-main">
            @theme.Name
        </button>
    }
</div>

<script>
    (function () {
        var switcher = document.querySelector('[data-theme-switcher]');
        if (!switcher || switcher.dataset.bound === 'true') return;
        switcher.dataset.bound = 'true';
        switcher.addEventListener('click', function (e) {
            var button = e.target.closest('[data-theme-switch]');
            if (!button) return;
            if (window.switchPrismTheme) window.switchPrismTheme(button.dataset.themeSwitch);
        });
    })();
</script>
